# Static Pages assets only. Worker-generated responses require Worker headers.
# Do not enforce a Content-Security-Policy until the Palace's Auth,
# illustrations, editor, chat, embeds and media dependencies are tested.
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
